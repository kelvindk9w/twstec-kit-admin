<?xml version="1.0" encoding="UTF-8"?>
<!--
    Suíte do pacote twstec/kit-admin, isolada do aplicativo: sobe uma
    aplicação Laravel mínima (Orchestra Testbench) com os providers que a
    descoberta automática instalaria (Filament, Livewire e os pacotes do kit,
    como numa aplicação nova), o model de usuário mínimo de uma
    aplicação e um PanelProvider que só registra o AdminPlugin. Os testes que
    dependem das telas, da factory e da demonstração do aplicativo continuam na
    suíte do starter.

    AMBIENTE DE UMA APLICAÇÃO LARAVEL NOVA, FIXADO: o container de
    desenvolvimento injeta o .env do starter inteiro no ambiente (idioma,
    allowlist de IP do admin, pepper…) e o CI não injeta nada. O
    tests/bootstrap.php apaga do processo toda variável que não está declarada
    aqui (e as do sistema, como PATH e HOME), e as declaradas aqui valem com
    force + server (o Laravel lê $_SERVER primeiro). A suíte sobe igual nos
    dois lugares.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Protections">
            <directory>tests/Protections</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <!-- A chave que o `key:generate` de uma aplicação nova grava no .env
             (fixa, só de teste). O pepper das chaves de API cai nela quando
             não há API_KEYS_HASH_PEPPER — o padrão de uma aplicação nova. -->
        <env name="APP_KEY" value="base64:dGVzdGUtZG8tcGFjb3RlLWFkbWluLTMyYnl0ZXMhISE=" force="true"/>
        <server name="APP_KEY" value="base64:dGVzdGUtZG8tcGFjb3RlLWFkbWluLTMyYnl0ZXMhISE=" force="true"/>
        <env name="APP_LOCALE" value="en" force="true"/>
        <server name="APP_LOCALE" value="en" force="true"/>
        <env name="APP_FALLBACK_LOCALE" value="en" force="true"/>
        <server name="APP_FALLBACK_LOCALE" value="en" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="testing" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
    </php>
</phpunit>
